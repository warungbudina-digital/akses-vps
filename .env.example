# Copy ke .env (jangan commit versi asli — sudah masuk .gitignore)

MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG
GENIEACS_MONGO_USER=genieacs
GENIEACS_MONGO_PASSWORD=CHANGE_ME_STRONG
GENIEACS_NBI_URL=http://genieacs-nbi:7557
GRPC_MONGO_PASSWORD=CHANGE_ME_STRONG

REDIS_PASSWORD=CHANGE_ME_STRONG
RADIUS_DB_PASSWORD=CHANGE_ME_STRONG
MQTT_PASSWORD=CHANGE_ME_STRONG

JWT_SECRET=CHANGE_ME_RANDOM_64_BYTE_HEX
INTERNAL_API_KEY=CHANGE_ME_RANDOM_KEY

GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG

DOMAIN=obc-crypto.com

# Tunnel token dari Cloudflare Zero Trust (Networks -> Tunnels -> nama
# tunnel -> Configure). Menggantikan Let's Encrypt/certbot - TLS publik
# untuk acs/cwmp/fs/api.obc-crypto.com ditangani Cloudflare edge, cloudflared
# di sini cuma bikin koneksi keluar ke edge, tidak ada port yang di-publish.
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_TUNNEL_TOKEN

# pentest-grpc-server (fleet pentest Raspberry Pi, terpisah dari JWT_SECRET/MQTT_PASSWORD di atas)
PENTEST_JWT_SECRET=CHANGE_ME_RANDOM_64_BYTE_HEX
PENTEST_INTERNAL_API_KEY=CHANGE_ME_RANDOM_KEY
PENTEST_MQTT_SERVICE_PASSWORD=CHANGE_ME_STRONG
PENTEST_MQTT_AGENT_PASSWORD=CHANGE_ME_STRONG
