# Secrets
docs/.local-credentials/
.env
genieacs/genieacs.env
mosquitto/config/passwd
# Hostinger API token (aslinya di ~/.config/hostinger/, di luar repo - baris
# ini cuma jaring pengaman kalau file/folder sejenis pernah dibuat di dalam repo)
hostinger/
*hostinger*token*
claude-hostinger-token*
# FreeRADIUS's own default "snakeoil" TLS certs/keys, extracted from the
# freeradius/freeradius-server image so the bind-mounted raddb tree is
# complete (see docker-compose.reference.yml's freeradius volume comment).
# NOT actually unique per install (baked into the public image, same for
# every user) - don't want them tracked in git either way; regenerate with
# freeradius/raddb/certs/bootstrap before relying on EAP-TLS for real.
freeradius/raddb/certs/

# Runtime data (persistent volumes when running compose locally / bind mounts)
mosquitto/data/
mosquitto/log/
mongodb/data/
backup/output/

# Generated
grpc-server/proto/gen/
grpc-server/bin/
pentest-grpc-server/proto/gen/
pentest-grpc-server/bin/
nginx/dashboards/*/index.html
viral-pipeline/dashboard.html

# Go
*.exe
*.test
*.out

# OS/editor
.DS_Store
*.swp

# Bootstrap per-peer berisi WG private key - JANGAN commit
wireguard/bootstraps/

# Python
__pycache__/
*.pyc
