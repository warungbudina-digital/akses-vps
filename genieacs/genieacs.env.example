# Copy ke genieacs.env (jangan commit versi asli) sebelum deploy.

GENIEACS_MONGODB_CONNECTION_URL=mongodb://genieacs:CHANGE_ME@mongodb:27017/genieacs?authSource=genieacs

GENIEACS_CWMP_PORT=7547
GENIEACS_CWMP_INTERFACE=0.0.0.0
GENIEACS_CWMP_SSL=false          # TLS di-terminate di nginx, upstream plain HTTP

GENIEACS_NBI_PORT=7557
GENIEACS_NBI_INTERFACE=0.0.0.0

GENIEACS_FS_PORT=7567
GENIEACS_FS_INTERFACE=0.0.0.0
GENIEACS_FS_HOSTNAME=fs.domain.com

GENIEACS_UI_PORT=3000
GENIEACS_UI_INTERFACE=0.0.0.0
GENIEACS_UI_JWT_SECRET=CHANGE_ME_RANDOM_64_BYTE_HEX

# Redis dipakai GenieACS untuk cache device data model (opsional tapi disarankan)
GENIEACS_REDIS_HOST=redis
GENIEACS_REDIS_PORT=6379

GENIEACS_LOG_FORMAT=json
GENIEACS_LOG_FILE=/dev/stdout
GENIEACS_ACCESS_LOG_FILE=/dev/stdout

GENIEACS_DEBUG=false
GENIEACS_EXT_DIR=/opt/genieacs/ext
